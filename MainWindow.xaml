<Window x:Class="EPSConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        mc:Ignorable="d"
        Title="EPS Converter &amp; Editor" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource PrimaryBrush}" Foreground="White">
            <MenuItem Header="Datei" Foreground="White">
                <MenuItem Header="EPS öffnen..." Click="OpenEPS_Click"/>
                <MenuItem Header="Bild öffnen..." Click="OpenImage_Click"/>
                <Separator/>
                <MenuItem Header="Als EPS speichern..." Click="SaveEPS_Click"/>
                <MenuItem Header="Als Bild exportieren..." Click="ExportImage_Click"/>
                <Separator/>
                <MenuItem Header="Beenden" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Bearbeiten" Foreground="White">
                <MenuItem Header="Rückgängig" Click="Undo_Click"/>
                <MenuItem Header="Wiederholen" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Skalieren..." Click="Scale_Click"/>
                <MenuItem Header="Drehen..." Click="Rotate_Click"/>
            </MenuItem>
            <MenuItem Header="Vektorisieren" Foreground="White">
                <MenuItem Header="Aktuelles Bild vektorisieren" Click="Vectorize_Click"/>
                <MenuItem Header="Batch-Konvertierung..." Click="BatchConvert_Click"/>
            </MenuItem>
            <MenuItem Header="Hilfe" Foreground="White">
                <MenuItem Header="Über" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Background="White" Padding="5">
            <Button Content="📁 EPS Öffnen" Click="OpenEPS_Click" ToolTip="EPS-Datei öffnen"/>
            <Button Content="🖼️ Bild Öffnen" Click="OpenImage_Click" ToolTip="Bilddatei öffnen"/>
            <Separator/>
            <Button Content="💾 Speichern" Click="SaveEPS_Click" ToolTip="Als EPS speichern"/>
            <Button Content="📤 Exportieren" Click="ExportImage_Click" ToolTip="Als Bild exportieren"/>
            <Separator/>
            <Button Content="🔄 Vektorisieren" Click="Vectorize_Click" Background="{StaticResource AccentBrush}" ToolTip="Bild in Vektor konvertieren"/>
            <Separator/>
            <Label Content="Auflösung:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ResolutionComboBox" Width="100" SelectedIndex="2" VerticalAlignment="Center">
                <ComboBoxItem Content="72 DPI"/>
                <ComboBoxItem Content="150 DPI"/>
                <ComboBoxItem Content="300 DPI"/>
                <ComboBoxItem Content="600 DPI"/>
            </ComboBox>
        </ToolBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - File List -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Dateien" FontSize="16" FontWeight="Bold" Margin="10" Foreground="{StaticResource PrimaryBrush}"/>
                    <ListBox x:Name="FileListBox" Grid.Row="1" Margin="5" SelectionChanged="FileListBox_SelectionChanged"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

            <!-- Center Panel - Canvas/Viewer -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="5">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="EditorCanvas" Background="#FAFAFA">
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        </Canvas>
                    </ScrollViewer>

                    <!-- Loading Indicator -->
                    <Grid x:Name="LoadingPanel" Background="#80FFFFFF" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⏳ Verarbeitung läuft..." FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <ProgressBar x:Name="ProgressBar" Width="300" Height="20" Margin="10" IsIndeterminate="True"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

            <!-- Right Panel - Properties -->
            <Border Grid.Column="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="5">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Eigenschaften" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="Dateiinfo:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBlock x:Name="FileNameText" TextWrapping="Wrap" Margin="0,2"/>
                        <TextBlock x:Name="FileSizeText" Margin="0,2"/>
                        <TextBlock x:Name="DimensionsText" Margin="0,2"/>

                        <TextBlock Text="Vektorisierungs-Einstellungen:" FontWeight="Bold" Margin="0,20,0,5"/>

                        <Label Content="Schwellenwert:"/>
                        <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="255" Value="128" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="ThresholdValueText" Text="128" HorizontalAlignment="Center"/>

                        <Label Content="Glättung:" Margin="0,10,0,0"/>
                        <Slider x:Name="SmoothingSlider" Minimum="0" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="SmoothingValueText" Text="2" HorizontalAlignment="Center"/>

                        <Label Content="Detail-Level:" Margin="0,10,0,0"/>
                        <Slider x:Name="DetailSlider" Minimum="1" Maximum="20" Value="10" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="DetailValueText" Text="10" HorizontalAlignment="Center"/>

                        <CheckBox x:Name="ColorModeCheckBox" Content="Farbvektorisierung" Margin="0,10,0,0" IsChecked="True"/>

                        <Button Content="🔧 Einstellungen anwenden" Click="ApplySettings_Click" Margin="0,20,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="{StaticResource PrimaryBrush}" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Bereit"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CoordinatesText" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
