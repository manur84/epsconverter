<Window x:Class="EPSConverter.Dialogs.RotateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drehen" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Bild drehen" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,5">
            <Label Content="Winkel (Grad):"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="AngleSlider" Grid.Column="0" Minimum="-180" Maximum="180" Value="0"
                        TickFrequency="15" IsSnapToTickEnabled="True" ValueChanged="AngleSlider_ValueChanged"/>
                <TextBox x:Name="AngleTextBox" Grid.Column="1" Text="0" Margin="10,0,0,0"
                         VerticalContentAlignment="Center" TextChanged="AngleTextBox_TextChanged"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button Content="↶ 90°" Width="70" Margin="5" Click="Rotate90Left_Click"/>
            <Button Content="↷ 90°" Width="70" Margin="5" Click="Rotate90Right_Click"/>
            <Button Content="↑↓ 180°" Width="70" Margin="5" Click="Rotate180_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Aktueller Winkel: " VerticalAlignment="Center"/>
            <TextBlock x:Name="PreviewText" Text="0°" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1" Margin="0,20,0,0">
            <Viewbox Width="150" Height="150">
                <Canvas Width="100" Height="100">
                    <Rectangle x:Name="PreviewRect" Width="60" Height="80" Fill="LightBlue"
                               Canvas.Left="20" Canvas.Top="10" Stroke="DarkBlue" StrokeThickness="2">
                        <Rectangle.RenderTransform>
                            <RotateTransform x:Name="PreviewRotation" Angle="0" CenterX="30" CenterY="40"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Line X1="50" Y1="0" X2="50" Y2="100" Stroke="Red" StrokeThickness="1" StrokeDashArray="2,2"/>
                    <Line X1="0" Y1="50" X2="100" Y2="50" Stroke="Red" StrokeThickness="1" StrokeDashArray="2,2"/>
                </Canvas>
            </Viewbox>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="OK_Click" Margin="0,0,10,0"/>
            <Button Content="Abbrechen" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
