<Window x:Class="EPSConverter.Dialogs.BrightnessContrastDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helligkeit & Kontrast" Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Helligkeit & Kontrast anpassen" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,5">
            <Label Content="Helligkeit:"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="BrightnessSlider" Grid.Column="0" Minimum="-100" Maximum="100" Value="0"
                        TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="BrightnessSlider_ValueChanged"/>
                <TextBox x:Name="BrightnessTextBox" Grid.Column="1" Text="0" Margin="10,0,0,0"
                         VerticalContentAlignment="Center" TextChanged="BrightnessTextBox_TextChanged"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,5">
            <Label Content="Kontrast:"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="ContrastSlider" Grid.Column="0" Minimum="-100" Maximum="100" Value="0"
                        TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="ContrastSlider_ValueChanged"/>
                <TextBox x:Name="ContrastTextBox" Grid.Column="1" Text="0" Margin="10,0,0,0"
                         VerticalContentAlignment="Center" TextChanged="ContrastTextBox_TextChanged"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10">
            <Button Content="Zurücksetzen" Width="100" Click="Reset_Click" Margin="0,0,10,0"/>
            <TextBlock x:Name="PreviewText" Text="Helligkeit: 0, Kontrast: 0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="OK_Click" Margin="0,0,10,0"/>
            <Button Content="Abbrechen" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
